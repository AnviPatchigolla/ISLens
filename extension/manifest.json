{
  "manifest_version": 3,
  "name": "ISLens — ISL to Speech (Prototype)",
  "version": "0.1.0",
  "description": "Prototype: recognizes a small set of Indian Sign Language phrases from your webcam and speaks them aloud.",
  "action": {
    "default_title": "Open ISLens panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
